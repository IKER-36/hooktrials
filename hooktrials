#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RUNTIME_DIR="$ROOT/.hooktrials"
RUNTIME_ENV="$RUNTIME_DIR/runtime.env"
UPDATE_STATE="$RUNTIME_DIR/update-state"

die() {
  printf '%s\n' "error: $*" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

env_value() {
  key=$1
  [ -f "$RUNTIME_ENV" ] || return 0
  sed -n "s/^${key}=//p" "$RUNTIME_ENV" | tail -n 1
}

set_env() {
  key=$1
  value=$2
  temp="$RUNTIME_ENV.tmp"
  awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    index($0, key "=") == 1 { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$RUNTIME_ENV" >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$RUNTIME_ENV"
}

valid_domain() {
  printf '%s' "$1" | grep -Eq '^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}$'
}

valid_https_origin() {
  case "$1" in
    https://*) return 0 ;;
    *) return 1 ;;
  esac
}

generate_runtime() {
  [ -f "$RUNTIME_ENV" ] && return
  require openssl
  mkdir -p "$RUNTIME_DIR"
  chmod 700 "$RUNTIME_DIR"
  umask 077

  port=${HOOKTRIALS_PORT:-3000}
  origin=${HOOKTRIALS_ORIGIN:-http://localhost:$port}
  postgres_password=$(openssl rand -hex 24)
  redis_password=$(openssl rand -hex 24)

  cat >"$RUNTIME_ENV" <<EOF
HOOKTRIALS_PROJECT=hooktrials-selfhost
HOOKTRIALS_MODE=${HOOKTRIALS_MODE:-local}
HOOKTRIALS_BIND=${HOOKTRIALS_BIND:-127.0.0.1}
HOOKTRIALS_PORT=$port
HOOKTRIALS_ORIGIN=$origin
HOOKTRIALS_DOMAIN=
ACME_EMAIL=
DEPLOYMENT_MODE=selfhost
REGISTRATION_MODE=first-user
COOKIE_SECURE=${COOKIE_SECURE:-false}
POSTGRES_PASSWORD=$postgres_password
REDIS_PASSWORD=$redis_password
DATABASE_URL=postgresql://hooktrials:$postgres_password@postgres:5432/hooktrials
REDIS_URL=redis://:$redis_password@redis:6379/0
SESSION_SECRET=$(openssl rand -hex 48)
PAYLOAD_ENCRYPTION_KEY=$(openssl rand -hex 32)
ENDPOINTS_LIMIT=0
MONITORS_LIMIT=0
DAILY_EVENTS_LIMIT=0
TRUST_PROXY_HOPS=1
EVENT_RETENTION_HOURS=72
MAX_BODY_BYTES=524288
EOF
  chmod 600 "$RUNTIME_ENV"
  printf '%s\n' "Generated private runtime configuration: $RUNTIME_ENV"
}

compose() {
  mode=$(env_value HOOKTRIALS_MODE)
  case "${mode:-local}" in
    domain) overlay="$ROOT/compose.domain.yml" ;;
    local | proxy) overlay="$ROOT/compose.local.yml" ;;
    *) die "unknown HOOKTRIALS_MODE: $mode" ;;
  esac
  docker compose \
    --project-directory "$ROOT" \
    --env-file "$RUNTIME_ENV" \
    -f "$ROOT/compose.yml" \
    -f "$overlay" \
    "$@"
}

show_access() {
  mode=$(env_value HOOKTRIALS_MODE)
  origin=$(env_value HOOKTRIALS_ORIGIN)
  case "${mode:-local}" in
    local) printf '%s\n' "Access: local only ($origin)" ;;
    proxy) printf '%s\n' "Access: existing HTTPS proxy ($origin)" ;;
    domain) printf '%s\n' "Access: direct public HTTPS ($origin)" ;;
  esac
}

configure_access() {
  generate_runtime
  mode=${1:-}
  if [ -z "$mode" ]; then
    printf '%s\n' "Choose how HookTrials is reached:"
    printf '%s\n' "  1) local  - this machine only"
    printf '%s\n' "  2) proxy  - your existing HTTPS reverse proxy"
    printf '%s\n' "  3) domain - direct public domain with automatic HTTPS"
    printf 'Mode [local/proxy/domain]: '
    read -r mode
  fi

  case "$mode" in
    1 | local)
      port=${2:-3000}
      printf '%s' "$port" | grep -Eq '^[0-9]{1,5}$' || die "port must be numeric"
      [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "port must be between 1 and 65535"
      set_env HOOKTRIALS_MODE local
      set_env HOOKTRIALS_BIND 127.0.0.1
      set_env HOOKTRIALS_PORT "$port"
      set_env HOOKTRIALS_ORIGIN "http://localhost:$port"
      set_env HOOKTRIALS_DOMAIN ""
      set_env ACME_EMAIL ""
      set_env COOKIE_SECURE false
      ;;
    2 | proxy)
      origin=${2:-}
      if [ -z "$origin" ]; then
        printf 'Public HTTPS origin (example: https://trials.example.com): '
        read -r origin
      fi
      valid_https_origin "$origin" || die "proxy origin must start with https://"
      port=${3:-3000}
      printf '%s' "$port" | grep -Eq '^[0-9]{1,5}$' || die "port must be numeric"
      [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "port must be between 1 and 65535"
      set_env HOOKTRIALS_MODE proxy
      set_env HOOKTRIALS_BIND 127.0.0.1
      set_env HOOKTRIALS_PORT "$port"
      set_env HOOKTRIALS_ORIGIN "${origin%/}"
      set_env HOOKTRIALS_DOMAIN ""
      set_env ACME_EMAIL ""
      set_env COOKIE_SECURE true
      ;;
    3 | domain)
      domain=${2:-}
      email=${3:-}
      if [ -z "$domain" ]; then
        printf 'Public domain (example: trials.example.com): '
        read -r domain
      fi
      if [ -z "$email" ]; then
        printf 'ACME email for certificate notices: '
        read -r email
      fi
      valid_domain "$domain" || die "invalid public domain"
      case "$email" in
        *@*.*) ;;
        *) die "invalid ACME email" ;;
      esac
      set_env HOOKTRIALS_MODE domain
      set_env HOOKTRIALS_BIND 0.0.0.0
      set_env HOOKTRIALS_PORT 443
      set_env HOOKTRIALS_ORIGIN "https://$domain"
      set_env HOOKTRIALS_DOMAIN "$domain"
      set_env ACME_EMAIL "$email"
      set_env COOKIE_SECURE true
      ;;
    *) die "mode must be local, proxy or domain" ;;
  esac

  compose config --quiet
  printf '%s\n' "Access configuration saved without rotating runtime secrets."
  show_access
  printf '%s\n' "Run ./hooktrials up to apply it."
}

external_doctor() {
  mode=$(env_value HOOKTRIALS_MODE)
  origin=$(env_value HOOKTRIALS_ORIGIN)
  if [ "${mode:-local}" = "local" ]; then
    printf '%s\n' "External access: disabled (local-only mode)."
    printf '%s\n' "Run ./hooktrials configure proxy or ./hooktrials configure domain."
    return 0
  fi
  require curl
  valid_https_origin "$origin" || die "public origin must use HTTPS"
  curl --fail --silent --show-error --max-time 15 "$origin/api/healthz" >/dev/null ||
    die "external API probe failed: $origin/api/healthz"
  printf '%s\n' "External HTTPS probe: OK ($origin)"
}

deep_doctor() {
  compose ps

  require curl
  origin=$(env_value HOOKTRIALS_ORIGIN)
  case "${origin:-}" in
    http://* | https://*) ;;
    *) die "HOOKTRIALS_ORIGIN must use http:// or https://" ;;
  esac
  curl --fail --silent --show-error --max-time 15 "$origin/api/healthz" >/dev/null ||
    die "API health probe failed: $origin/api/healthz"
  setup=$(curl --fail --silent --show-error --max-time 15 "$origin/api/v1/setup") ||
    die "setup discovery probe failed: $origin/api/v1/setup"
  printf '%s\n' "API health and setup discovery: OK"
  case "$setup" in
    *'deploymentMode'*) printf '%s\n' "Installation metadata: OK" ;;
    *) die "setup discovery response did not include installation metadata" ;;
  esac

  available_kb=$(df -Pk "$ROOT" | awk 'NR == 2 { print $4 }')
  if [ -n "${available_kb:-}" ] && [ "$available_kb" -lt 1048576 ]; then
    printf '%s\n' "warning: less than 1 GiB is available on the application volume" >&2
  else
    printf '%s\n' "Application volume: OK"
  fi
  if [ -d "$ROOT/backups" ] && find "$ROOT/backups" -maxdepth 1 -name 'hooktrials-*.sql.gz' -print -quit | grep -q .; then
    printf '%s\n' "PostgreSQL backup: present"
  else
    printf '%s\n' "warning: no local PostgreSQL backup found; run ./hooktrials backup" >&2
  fi
  show_access
  show_update_state
}

create_backup() {
  [ -f "$RUNTIME_ENV" ] || die "HookTrials is not initialized"
  mkdir -p "$ROOT/backups"
  backup="$ROOT/backups/hooktrials-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"
  dump="$backup.sql.tmp.$$"
  compressed="$backup.tmp.$$"
  if ! compose exec -T postgres pg_dump -U hooktrials hooktrials >"$dump"; then
    rm -f "$dump" "$compressed"
    die "PostgreSQL backup failed"
  fi
  if ! gzip <"$dump" >"$compressed"; then
    rm -f "$dump" "$compressed"
    die "Backup compression failed"
  fi
  rm -f "$dump"
  mv "$compressed" "$backup"
  chmod 600 "$backup"
  printf '%s\n' "$backup"
}

create_runtime_backup() {
  stamp=$1
  [ -f "$RUNTIME_ENV" ] || die "HookTrials is not initialized"
  runtime_backup="$ROOT/backups/runtime-$stamp.env"
  cp "$RUNTIME_ENV" "$runtime_backup"
  chmod 600 "$runtime_backup"
  printf '%s\n' "$runtime_backup"
}

current_release() {
  release=$(git -C "$ROOT" describe --tags --exact-match HEAD 2>/dev/null || true)
  if [ -n "$release" ]; then
    printf '%s\n' "$release"
  else
    printf 'commit %s\n' "$(git -C "$ROOT" rev-parse --short HEAD)"
  fi
}

state_value() {
  key=$1
  [ -f "$UPDATE_STATE" ] || return 0
  sed -n "s/^${key}=//p" "$UPDATE_STATE" | tail -n 1
}

write_update_state() {
  state=$1
  previous_sha=$2
  previous_ref=$3
  target=$4
  backup=$5
  runtime_backup=$6
  temp="$UPDATE_STATE.tmp.$$"
  mkdir -p "$RUNTIME_DIR"
  {
    printf 'state=%s\n' "$state"
    printf 'previous_sha=%s\n' "$previous_sha"
    printf 'previous_ref=%s\n' "$previous_ref"
    printf 'target=%s\n' "$target"
    printf 'backup=%s\n' "$backup"
    printf 'runtime_backup=%s\n' "$runtime_backup"
    printf 'updated_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$UPDATE_STATE"
}

show_update_state() {
  [ -f "$UPDATE_STATE" ] || return 0
  printf '%s\n' "Last update: $(state_value state)"
  target=$(state_value target)
  [ -n "$target" ] && printf '%s\n' "Target release: $target"
  updated_at=$(state_value updated_at)
  [ -n "$updated_at" ] && printf '%s\n' "Updated at: $updated_at"
  backup=$(state_value backup)
  [ -n "$backup" ] && printf '%s\n' "Database backup: $backup"
  runtime_backup=$(state_value runtime_backup)
  [ -n "$runtime_backup" ] && printf '%s\n' "Runtime backup: $runtime_backup"
}

assert_clean_checkout() {
  require git
  git -C "$ROOT" rev-parse --show-toplevel >/dev/null 2>&1 ||
    die "self-hosted updates require a Git checkout"
  [ -z "$(git -C "$ROOT" status --porcelain)" ] ||
    die "working tree is not clean; commit or stash local changes before updating"
}

update_stack() {
  compose build --pull
  compose up -d --wait --wait-timeout 120
  compose ps
}

restore_previous_checkout() {
  if [ -n "${previous_ref:-}" ] && git -C "$ROOT" show-ref --verify --quiet "refs/heads/$previous_ref"; then
    git -C "$ROOT" switch "$previous_ref" >/dev/null 2>&1 ||
      git -C "$ROOT" switch --detach "$previous_sha" >/dev/null
  else
    git -C "$ROOT" switch --detach "$previous_sha" >/dev/null
  fi
}

update_installation() {
  release=
  check_only=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --release)
        [ "$#" -ge 2 ] || die "--release requires a tag, e.g. v0.13.0"
        release=$2
        shift 2
        ;;
      --release=*)
        release=${1#*=}
        shift
        ;;
      --check | --dry-run)
        check_only=1
        shift
        ;;
      *) die "unknown update option: $1" ;;
    esac
  done

  assert_clean_checkout
  previous_sha=$(git -C "$ROOT" rev-parse HEAD)
  previous_ref=$(git -C "$ROOT" symbolic-ref --quiet --short HEAD || true)

  if [ -n "$release" ]; then
    git -C "$ROOT" fetch --tags origin
    git -C "$ROOT" rev-parse --verify --quiet "refs/tags/$release^{commit}" >/dev/null ||
      die "release tag not found: $release"
  fi

  if [ "$check_only" -eq 1 ]; then
    printf '%s\n' "Current: $(current_release)"
    if [ -n "$release" ]; then
      printf '%s\n' "Available: $release"
      if [ "$(git -C "$ROOT" rev-parse HEAD)" = "$(git -C "$ROOT" rev-list -1 "$release^{commit}")" ]; then
        printf '%s\n' "Status: already on this release"
      else
        printf '%s\n' "Status: ready to update (no data or containers changed)"
      fi
    else
      printf '%s\n' "Specify a release with --release vX.Y.Z to check a tagged update."
    fi
    return 0
  fi

  backup_path=$(create_backup)
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  runtime_backup=$(create_runtime_backup "$stamp")
  write_update_state prepared "$previous_sha" "$previous_ref" "${release:-current-checkout}" "$backup_path" "$runtime_backup"
  if [ -n "$release" ]; then
    git -C "$ROOT" switch --detach "$release" >/dev/null || {
      printf '%s\n' "error: could not switch to release; checkout unchanged" >&2
      write_update_state failed "$previous_sha" "$previous_ref" "$release" "$backup_path" "$runtime_backup"
      exit 1
    }
  fi

  if ! update_stack; then
    printf '%s\n' "update failed; restoring previous checkout: $previous_sha" >&2
    restore_previous_checkout || true
    if ! update_stack; then
      printf '%s\n' "rollback stack restart failed; inspect logs before retrying" >&2
    fi
    write_update_state rolled-back "$previous_sha" "$previous_ref" "${release:-current-checkout}" "$backup_path" "$runtime_backup"
    die "update failed; database backup available at $backup_path"
  fi

  write_update_state complete "$previous_sha" "$previous_ref" "${release:-current-checkout}" "$backup_path" "$runtime_backup"

  printf '%s\n' "Update complete."
  printf '%s\n' "Release: ${release:-current checkout}"
  printf '%s\n' "Backup: $backup_path"
  printf '%s\n' "Runtime backup: $runtime_backup"
  printf '%s\n' "Rollback: ./hooktrials rollback --yes"
  printf '%s\n' "Run ./hooktrials doctor --external to verify public access."
}

rollback_installation() {
  [ "${1:-}" = "--yes" ] || die "rollback changes the running checkout; rerun: ./hooktrials rollback --yes"
  [ -f "$RUNTIME_ENV" ] || die "HookTrials is not initialized"
  [ -f "$UPDATE_STATE" ] || die "no previous update is available to roll back"
  assert_clean_checkout

  previous_sha=$(state_value previous_sha)
  [ -n "$previous_sha" ] || die "update state has no previous checkout"
  current_sha=$(git -C "$ROOT" rev-parse HEAD)
  [ "$current_sha" != "$previous_sha" ] || die "the current checkout is already the recorded previous version"
  target=$(state_value target)
  backup_path=$(state_value backup)
  runtime_backup=$(state_value runtime_backup)

  printf '%s\n' "Rolling back code from ${target:-the last update}..."
  git -C "$ROOT" switch --detach "$previous_sha" >/dev/null ||
    die "could not restore the previous checkout"
  if ! update_stack; then
    git -C "$ROOT" switch --detach "$current_sha" >/dev/null 2>&1 || true
    update_stack >/dev/null 2>&1 || true
    die "rollback stack restart failed; inspect logs before retrying"
  fi
  write_update_state rolled-back "$previous_sha" "" "$target" "$backup_path" "$runtime_backup"
  printf '%s\n' "Rollback complete."
  printf '%s\n' "Database backup retained at: $backup_path"
  printf '%s\n' "The database was not changed; restore it only if a migration requires recovery."
}

require docker
docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"

case "${1:-up}" in
  up)
    generate_runtime
    compose up -d --build
    compose ps
    printf '\nHookTrials: %s\n' "$(env_value HOOKTRIALS_ORIGIN)"
    show_access
    printf '%s\n' "Create the first account to become installation owner."
    ;;
  down)
    [ -f "$RUNTIME_ENV" ] || die "HookTrials is not initialized"
    compose down
    ;;
  logs)
    [ -f "$RUNTIME_ENV" ] || die "HookTrials is not initialized"
    if [ -n "${2:-}" ]; then
      compose logs --tail=200 -f "$2"
    else
      compose logs --tail=200 -f
    fi
    ;;
  status)
    [ -f "$RUNTIME_ENV" ] || die "HookTrials is not initialized"
    compose ps
    show_access
    printf '%s\n' "Release: $(current_release)"
    show_update_state
    ;;
  doctor)
    generate_runtime
    compose config --quiet
    printf '%s\n' "Docker, Compose and configuration: OK"
    if [ "${2:-}" = "--external" ]; then
      external_doctor
    elif [ "${2:-}" = "--deep" ]; then
      deep_doctor
    else
      show_access
    fi
    ;;
  configure)
    configure_access "${2:-}" "${3:-}" "${4:-}"
    ;;
  update)
    [ -f "$RUNTIME_ENV" ] || die "HookTrials is not initialized"
    shift
    update_installation "$@"
    ;;
  rollback)
    rollback_installation "${2:-}"
    ;;
  backup)
    printf 'Backup created: %s\n' "$(create_backup)"
    ;;
  reset)
    [ "${2:-}" = "--yes" ] || die "reset deletes all HookTrials data; rerun: ./hooktrials reset --yes"
    [ -f "$RUNTIME_ENV" ] || die "HookTrials is not initialized"
    compose down --volumes
    rm -f "$RUNTIME_ENV"
    printf '%s\n' "HookTrials data and runtime secrets removed."
    ;;
  help | -h | --help)
    printf '%s\n' "Usage: ./hooktrials {up|down|logs [service]|status|doctor [--external|--deep]|configure [local|proxy|domain]|update [--release vX.Y.Z] [--check]|rollback --yes|backup|reset --yes}"
    ;;
  *)
    printf '%s\n' "Usage: ./hooktrials {up|down|logs [service]|status|doctor [--external|--deep]|configure [local|proxy|domain]|update [--release vX.Y.Z] [--check]|rollback --yes|backup|reset --yes}" >&2
    exit 2
    ;;
esac
